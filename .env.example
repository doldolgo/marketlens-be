# marketlens-be 환경변수 예시.
#
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 의해 커밋되지 않는다. 실제 키·시크릿은 절대 커밋 금지.
# 새 환경변수를 추가할 때는 이 파일에도 키 이름을 함께 추가할 것 (값은 비우거나 예시만).

# ── 앱 설정 (전부 선택 — 비우면 app/core/config.py 의 기본값 사용) ──────────

# HTTP 클라이언트 튜닝
#HTTP_TIMEOUT=3.0
#HTTP_CONNECT_TIMEOUT=1.5
#HTTP_MAX_CONNECTIONS=100
#HTTP_MAX_KEEPALIVE=50

# 호가창 기본 조회 깊이
#DEFAULT_ORDERBOOK_DEPTH=10

# 원화 기준 거래소 / 해외 거래소 호가 통화
#KRW_REFERENCE_EXCHANGE=upbit
#KRW_REFERENCE_QUOTE=KRW
#OVERSEAS_QUOTE=USDT

# 환율 (USD/KRW) 출처 — 하나은행 고시환율 사이트의 베이스 URL.
# 기본값 그대로면 설정할 필요가 없다. 도메인이 바뀌거나 프록시를
# 태워야 할 때만 덮어쓴다 (경로는 코드에 있으므로 origin 만 적는다).
#HANA_BASE_URL=https://www.kebhana.com

# 수집 루프 주기 / 저빈도 작업 주기 (초)
#COLLECT_INTERVAL_SECONDS=1.0
#PERSIST_INTERVAL_SECONDS=60.0
#ARCHIVE_INTERVAL_SECONDS=60.0
#WALLET_REFRESH_SECONDS=60.0

# 호가 깊이 선별 조회 — 김프 하한(%)과 코인 수 상한 (바이낸스 weight 안전장치)
#DEPTH_WATCH_MIN_PERCENT=1.0
#DEPTH_WATCH_MAX_COUNT=12

# 전종목 스캔
#SCAN_SUSPICIOUS_PERCENT=5.0
#SCAN_EXCLUDED_BASES=["AI"]

# 거래소 API 베이스 URL (장애 시 프록시/미러로 교체용)
#UPBIT_BASE_URL=https://api.upbit.com
#BITHUMB_BASE_URL=https://api.bithumb.com
#BINANCE_SPOT_BASE_URL=https://api.binance.com
#BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# ── 데이터베이스 ─────────────────────────────────
# 접속 정보는 호스트를 코드에 적지 않고 이 URL 하나로 주입한다.
# 로컬:  docker compose -f docker-compose.dev.yml up -d 로 띄운 PostgreSQL
# AWS:   postgresql://marketlens:<비밀번호>@<RDS엔드포인트>:5432/marketlens
#DATABASE_URL=postgresql://marketlens:marketlens@localhost:5432/marketlens

# ── AWS (배포 시 사용 예정 — 아직 코드에서 읽지 않음) ──────────────────────
# 로컬 개발에서는 AWS CLI 프로필(aws configure)을 쓰고, EC2/ECS 에서는
# IAM Role 을 쓰는 것이 권장이라 이 키들이 필요 없을 수 있다.
# 액세스 키를 .env 로 쓰는 것은 최후의 수단으로만.
#AWS_REGION=ap-northeast-2
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- 거래소 api 키 -------

# BINANCE_API_KEY_TRADE=3
# BINANCE_SECRET_KEY_TRADE=3

# UPBIT_API_KEY=3
# UPBIT_SECRET_KEY=3